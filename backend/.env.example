NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# JWT Secrets (Min 64 characters)
JWT_ACCESS_SECRET=takshvaya-super-secret-access-token-key-2026-min-64-characters-very-secure
JWT_REFRESH_SECRET=takshvaya-super-secret-refresh-token-key-2026-min-64-characters-very-secure
JWT_ADMIN_SECRET=takshvaya-super-secret-admin-token-key-2026-min-64-characters-very-secure

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Admin Allowlist Gateway (Strict Dual-Factor OTP Only)
ADMIN_EMAIL=admin@takshvaya.org
ADMIN_PHONE=9876543210

# Database & Cache (Optional - In-Memory Fallback Active)
DATABASE_URL=
REDIS_URL=

# Anti-Fraud & Cloudflare Turnstile
TURNSTILE_SECRET_KEY=mock-turnstile-secret-key
